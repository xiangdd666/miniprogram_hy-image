/**
 * app.wxss - 全局暗黑工作台基础样式
 */
page {
  background-color: #0b0e14;
  color: #f1f5f9;
  font-family: -apple-system, BlinkMacSystemFont, "PingFang SC", "Helvetica Neue", sans-serif;
  font-size: 28rpx;
  line-height: 1.5;
  box-sizing: border-box;
}

view,
text,
button,
input,
textarea,
scroll-view {
  box-sizing: border-box;
}

button {
  margin: 0;
  padding: 0;
  background: initial;
  font-weight: 500;
  line-height: normal;
}

button::after {
  border: none;
}
